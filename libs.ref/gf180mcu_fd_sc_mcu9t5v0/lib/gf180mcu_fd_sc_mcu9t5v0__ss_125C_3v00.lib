      pin(RN) {
        direction : input ;
      }

      pin(SETN) {
        direction : input ;
      }

      pin(SE) {
        direction : input ;
        signal_type : test_scan_enable ;
      }

      ff(IQ1,IQN1) {
        clocked_on : "CLK" ;
        next_state : "D" ;
        clear : "!RN" ;
        preset : "!SETN" ;
        clear_preset_var1 : L ;
        clear_preset_var2 : H ;
      }

      pin(CLK) {
        clock : true ;
        direction : input ;
      }

      pin(D) {
        direction : input ;
      }

      pin(Q) {
        direction : output ;
        function : IQ1 ;
        signal_type : test_scan_out ;
      }
    }
  }

