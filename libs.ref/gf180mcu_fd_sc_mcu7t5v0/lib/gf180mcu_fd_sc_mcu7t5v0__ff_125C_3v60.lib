    test_cell() {

      pin(SI) {
        direction : input ;
        signal_type : test_scan_in ;
      }

      pin(RN) {
        direction : input ;
      }

      pin(SETN) {
        direction : input ;
      }

      pin(SE) {
        direction : input ;
        signal_type : test_scan_enable ;
      }

      ff(IQ1,IQN1) {
        clocked_on : "CLK" ;
        next_state : "D" ;
        clear : "!RN" ;
        preset : "!SETN" ;
